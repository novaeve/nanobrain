[Unit]
Description=nanoBrain public research site and leaderboard API
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/aliyunsb/zim_rider/nanobrain/nanobrain-github/site
ExecStart=/usr/bin/python3 /mnt/aliyunsb/zim_rider/nanobrain/nanobrain-github/site/site_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
