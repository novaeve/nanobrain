# nanoBrain dataset configuration. Copy this file to .env.
# Set the bundle URL supplied by the company data host.
NANOBRAIN_DATA_URL=
# Optional SHA-256 of the downloaded ZIP/TAR archive.
NANOBRAIN_DATA_SHA256=
# The default is assets/nanobrain_v3_100k_metadata_v2 relative to the repo.
# NANOBRAIN_DATA_DIR=/data/nanobrain_v3_100k_metadata_v2
