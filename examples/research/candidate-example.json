{
  "files": {
    "losses/robust.py": "import torch\n\ndef compute(prediction, target, delta=1.0):\n    error = prediction - target\n    return (delta * delta * (torch.sqrt(1.0 + (error / delta).square()) - 1.0)).mean()\n",
    "modules/gated.py": "import torch\nfrom torch import nn\n\nclass GatedResidual(nn.Module):\n    def __init__(self, hidden_dim, expansion=2):\n        super().__init__()\n        self.up = nn.Linear(hidden_dim, hidden_dim * expansion)\n        self.down = nn.Linear(hidden_dim * expansion, hidden_dim)\n        self.gate = nn.Linear(hidden_dim, hidden_dim)\n\n    def forward(self, state):\n        correction = self.down(torch.nn.functional.silu(self.up(state)))\n        return state + torch.sigmoid(self.gate(state)) * correction\n\n\ndef build(hidden_dim, expansion=2):\n    return GatedResidual(hidden_dim, expansion)\n",
    "optimizers/normalized.py": "import torch\nfrom torch.optim import Optimizer\n\nclass NormalizedSGD(Optimizer):\n    def __init__(self, parameters, lr, weight_decay, epsilon=0.0001):\n        super().__init__(parameters, dict(lr=lr, weight_decay=weight_decay, epsilon=epsilon))\n\n    @torch.no_grad()\n    def step(self, closure=None):\n        if closure is not None:\n            raise ValueError('closure is unsupported')\n        for group in self.param_groups:\n            for parameter in group['params']:\n                if parameter.grad is not None:\n                    gradient = parameter.grad\n                    scale = gradient.square().mean().sqrt() + group['epsilon']\n                    parameter.mul_(1.0 - group['lr'] * group['weight_decay'])\n                    parameter.add_(gradient / scale, alpha=-group['lr'])\n\n\ndef build(parameters, lr, weight_decay, epsilon=0.0001):\n    return NormalizedSGD(parameters, lr, weight_decay, epsilon)\n"
  },
